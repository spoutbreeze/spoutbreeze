{~
@dashboard_cards = [
    ['Broadcasts', '0 live', 'bg-brand-50 dark:bg-brand-500/15', 'text-brand-500'],
    ['Agents', 'WebSummoner grid', 'bg-blue-50 dark:bg-blue-500/15', 'text-blue-500'],
    ['Servers', 'Not connected', 'bg-success-50 dark:bg-success-500/15', 'text-success-500'],
    ['Destinations', '0 configured', 'bg-orange-50 dark:bg-orange-500/15', 'text-orange-500'],
];
~}
<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-2xl font-bold text-gray-800 dark:text-white/90">Dashboard</h2>
    <nav>
        <ol class="flex items-center gap-1.5">
            <li><a class="text-sm text-gray-500 hover:text-brand-600 dark:text-gray-400" href="/">Home</a></li>
            <li class="text-gray-400">/</li>
            <li class="text-sm font-medium text-gray-800 dark:text-white/90">Dashboard</li>
        </ol>
    </nav>
</div>

<div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {~ foreach (@dashboard_cards as @card): ~}
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-sm text-gray-500 dark:text-gray-400">{{ @card.0 }}</span>
                <h4 class="mt-2 text-xl font-bold text-gray-800 dark:text-white/90">{{ @card.1 }}</h4>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-xl {{ @card.2 }}">
                <span class="{{ @card.3 }} text-2xl font-bold">●</span>
            </div>
        </div>
    </div>
    {~ endforeach; ~}
</div>

<div class="rounded-2xl border border-gray-200 bg-white px-5 py-7 dark:border-gray-800 dark:bg-white/[0.03] xl:px-10 xl:py-12">
    <div class="mx-auto w-full max-w-[630px] text-center">
        <h3 class="mb-4 text-2xl font-semibold text-gray-800 dark:text-white/90">SpoutBreeze console is up</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 sm:text-base">
            The Sukarix application is running and connected.
            <a class="text-brand-600 hover:underline" href="/broadcasts">Start or stop a broadcast</a>
            from the Broadcasts screen. Destinations can be a generic RTMP URL or YouTube Live.
        </p>
    </div>
</div>
