<div class="rounded-2xl border border-gray-200 bg-white p-8 dark:border-gray-800 dark:bg-white/[0.03]">
    <h1 class="mb-2 text-xl font-semibold text-gray-800 dark:text-white/90">Reset your password</h1>

    {~ if (!empty(@sent)): ~}
    <div class="mb-4 rounded-xl border border-success-200 bg-success-50 px-4 py-3 text-sm text-success-700 dark:border-success-500/30 dark:bg-success-500/10 dark:text-success-400">
        If that email belongs to an account, a reset link is on its way. The link expires in one hour.
    </div>
    <a href="/login" class="text-sm text-brand-600 hover:underline">Back to sign in</a>
    {~ else: ~}
    <p class="mb-6 text-sm text-gray-500 dark:text-gray-400">Enter your account email and we will send a reset link.</p>
    <form method="post" action="/forgot" class="space-y-4">
        <input type="hidden" name="csrf_token" value="{{ @csrf_token }}"/>
        <div>
            <label class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300" for="email">Email</label>
            <input id="email" name="email" type="email" required autofocus class="h-11 w-full rounded-lg border border-gray-300 px-3 text-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white"/>
        </div>
        <button type="submit" class="h-11 w-full rounded-lg bg-brand-500 text-sm font-medium text-white hover:bg-brand-600">Send reset link</button>
    </form>
    <p class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">
        <a href="/login" class="text-brand-600 hover:underline">Back to sign in</a>
    </p>
    {~ endif; ~}
</div>
