# SpoutBreeze stack configuration. Copy to deploy/.env (gitignored).
#
# The PHP console is NOT configured here. Fat-Free hot-loads ini files, so
# its settings live in app/config/ — see config-production.ini.sample. The
# only variable it reads is APP_ENV, set in deploy/compose.core.yml.
#
# What remains below configures the JVM services (manager, agent, interactor)
# and the values compose interpolates.

# BigBlueButton server the JVM services talk to
BBB_FQDN=
BBB_SHARED_SECRET=
BBB_CHECKSUM_ALGO=sha256
BBB_API_URL=

# Interactor callbacks and the plugin manifest the manager injects
SPB_CALLBACK_BASE=
SPB_PLUGIN_MANIFEST_URL=

# Chat gateway (interactor)
CHAT_TWITCH_ENABLED=false
TWITCH_CHAT_TOKEN=
TWITCH_CHAT_CHANNEL=
TWITCH_CHAT_NICK=
CHAT_FACEBOOK_ENABLED=false
FACEBOOK_CHAT_TOKEN=
CHAT_FACEBOOK_POLL_MS=10000
CHAT_MIN_INTERVAL_MS=2000
